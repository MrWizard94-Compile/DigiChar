# DigiChar only calls a local Ollama endpoint from the native desktop process.
# Docker should publish Ollama on loopback, for example: 127.0.0.1:11434:11434.
DIGICHAR_OLLAMA_URL=http://127.0.0.1:11434

# qwen2.5:3b is the default and fits comfortably within a 6 GB GPU budget.
# Override this with any model already pulled in the user's local Ollama container.
DIGICHAR_OLLAMA_MODEL=qwen2.5:3b

# DISABLE_HMR=true
# Optional: disables Vite hot module reloading for low-resource editing sessions.
